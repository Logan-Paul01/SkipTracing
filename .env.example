BOT_TOKEN=your_botfather_token_here
DB_PATH=skiptrace.db

# Fast web search: set one of these to make "web" mode the default.
# Exa is preferred when both are set.
TAVILY_API_KEY=tvly-your_key_here
EXA_API_KEY=your_exa_key_here

# Free dossiers per account, then the launch plan shown in the paywall.
FREE_SEARCHES=10
PLAN_PRICE_NGN=200
PLAN_SEARCHES=20
PLAN_DAYS=30

# Manual payment for SkipTrace Premium: printed in /premium and the paywall.
# Leave the number empty and the bot asks the user to contact the operator.
PAYMENT_BANK=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=

# Optional: lock the hidden /broadcast command to one account. Leave empty and
# the first account to send /broadcast claims it.
OWNER_ID=
